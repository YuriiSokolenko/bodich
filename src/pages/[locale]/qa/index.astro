---
import SiteLayout from '../../../layouts/SiteLayout.astro';
import SiteContainer from '../../../components/ui/SiteContainer.astro';
import { locales, type Locale } from '../../../i18n';
import { qaDrafts, qaFull, qaSections, sectionCopy, qaSection, qaHref, qaImage, qaImageAlt } from '../../../qa/catalog';

export function getStaticPaths() {
  return process.env.BODICH_MEDIA_PROFILE === 'qa_full'
    ? locales.map((locale) => ({ params: { locale }, props: { locale } }))
    : [];
}

const { locale } = Astro.props as { locale: Locale };
const title = locale === 'ro' ? 'Catalog de referință pentru testare' : 'Full content QA reference catalog';
const notice = locale === 'ro'
  ? 'EXCLUSIV PENTRU TESTARE — 132 de referințe de cercetare KingTech, NU produse BODICH aprobate. Descrierile, datele tehnice și ilustrațiile nu constituie oferte sau dovezi despre un produs real.'
  : 'TESTING ONLY — 132 KingTech research references, NOT approved BODICH products. Descriptions, technical data and illustrations are not sales offers or evidence of real BODICH products.';
---
{qaFull && (
  <SiteLayout locale={locale} page="products" title={title} description={notice}>
    <SiteContainer>
      <div data-qa-catalog class="py-12 sm:py-20">
        <p class="font-semibold uppercase tracking-widest text-bodich-accent">QA FULL · {qaDrafts.length} references</p>
        <h1 class="mt-4 font-display text-4xl font-black text-bodich-ink">{title}</h1>
        <p class="mt-5 rounded-control border border-bodich-accent p-5 text-sm leading-7 text-bodich-ink">{notice}</p>
        <nav aria-label="QA languages" class="mt-5 flex gap-5 text-bodich-accent-hover">
          <a href={qaHref('en')} lang="en">English</a>
          <a href={qaHref('ro')} lang="ro">Română</a>
        </nav>
        <nav aria-label="QA categories" class="mt-8 flex flex-wrap gap-3">
          {qaSections.map((section) => (
            <a class="rounded-control border border-bodich-border p-3 text-sm text-bodich-accent-hover" href={'#qa-' + section}>
              {sectionCopy[section][locale]} ({qaDrafts.filter((d) => qaSection(d) === section).length})
            </a>
          ))}
        </nav>
        {qaSections.map((section) => (
          <section id={'qa-' + section} class="mt-14" aria-label={sectionCopy[section][locale]}>
            <h2 class="mb-6 font-display text-2xl font-bold">{sectionCopy[section][locale]}</h2>
            <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
              {qaDrafts.filter((item) => qaSection(item) === section).map((item) => (
                <li class="min-w-0 overflow-hidden rounded-control border border-bodich-border bg-bodich-panel">
                  <a class="block hover:text-bodich-accent-hover focus-visible:outline-2 focus-visible:outline-bodich-accent" href={qaHref(locale, item.slug)}>
                    <img src={qaImage(item.sourceId)} alt={qaImageAlt(item.sourceId, locale)} loading="lazy" width="600" height="450" class="aspect-[4/3] w-full object-contain"/>
                    <div class="p-5">
                      <p class="text-xs font-semibold uppercase tracking-wider text-bodich-accent">{item.sourceId} · DRAFT · {item.source.status}</p>
                      <h3 class="mt-3 text-lg font-bold">{item.copy[locale]?.name}</h3>
                      <p class="mt-3 text-sm leading-6 text-bodich-muted">{item.copy[locale]?.summary}</p>
                      <p class="mt-3 text-xs text-bodich-muted">{locale === 'ro' ? 'Diagramă ilustrativă, nu fotografie' : 'Illustrative diagram, not a photograph'}</p>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </SiteContainer>
  </SiteLayout>
)}
