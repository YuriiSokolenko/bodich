---
import SectionPage from '../../components/SectionPage.astro';
import { sectionKeys, type SectionKey } from '../../i18n';

export function getStaticPaths() {
  return sectionKeys.map((section) => ({ params: { section } }));
}

const section = Astro.params.section as SectionKey;
---

<SectionPage locale="en" page={section} />
