---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/global.css';
import { isIndexableInformationPage, isSeoPublicationContext } from '../seo/policy';
import { hrefFor, locales, translations, type Locale, type PageKey } from '../i18n';

interface Props {
  locale: Locale;
  page: PageKey;
  subpath?: string;
  title?: string;
  description?: string;
}

const { locale, page, subpath, title, description } = Astro.props;
const pageText = translations[locale].pages[page];
const resolvedTitle = title ?? pageText.title;
const resolvedDescription = description ?? pageText.description;
const site = Astro.site;
const mediaProfile = import.meta.env.BODICH_MEDIA_PROFILE || 'release_safe';
const indexable = isSeoPublicationContext(site, mediaProfile, import.meta.env.BASE_URL) && isIndexableInformationPage(page, subpath);
const pageSchema = indexable && site ? {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': new URL(hrefFor(locale, page, subpath), site).toString(),
  name: resolvedTitle,
  description: resolvedDescription,
  inLanguage: locale,
  isPartOf: { '@type': 'WebSite', name: 'BODICH', url: new URL(import.meta.env.BASE_URL, site).toString() },
} : undefined;
const canonical = site ? new URL(hrefFor(locale, page, subpath), site).toString() : undefined;
const presentationMedia = ['beta_presentation', 'private_review', 'qa_full'].includes(mediaProfile);
const faviconHref = `${import.meta.env.BASE_URL.replace(/\/+$/, '')}/favicon.svg`;
---

<!doctype html>
<html lang={locale} data-media-profile={mediaProfile}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={resolvedDescription} />
    <meta name="robots" content={indexable ? "index, follow" : "noindex, nofollow"} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === "ro" ? "ro_RO" : "en_US"} />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={resolvedDescription} />
    {indexable && canonical && <meta property="og:url" content={canonical} />}
    <title>{resolvedTitle} | BODICH</title>
    {presentationMedia && <link rel="icon" type="image/svg+xml" href={faviconHref} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {site && locales.map((lang) => (
      <link rel="alternate" hreflang={lang} href={new URL(hrefFor(lang, page, subpath), site).toString()} />
    ))}
    {site && <link rel="alternate" hreflang="x-default" href={new URL(hrefFor('en', page, subpath), site).toString()} />}
    {pageSchema && <script type="application/ld+json" set:html={JSON.stringify(pageSchema).replace(/</g, '\\u003c')} />}
  </head>
  <body class="min-h-dvh bg-bodich-canvas text-bodich-ink antialiased">
    <a href="#main-content" class="sr-only rounded-control bg-bodich-accent px-3 py-2 text-bodich-accent-ink focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:z-[60]">
      {translations[locale].skipContentLabel}
    </a>
    <div class="flex min-h-dvh flex-col">
      <SiteHeader locale={locale} page={page} subpath={subpath} />
      {mediaProfile === "qa_full" && (\n        <aside data-full-qa-notice class="border-b border-bodich-accent bg-bodich-panel px-6 py-3 text-center text-sm font-semibold text-bodich-ink">\n          {locale === "ro" ? "PREVIZUALIZARE DE TEST — referințe externe neaprobate; nu sunt produse BODICH." : "FULL CONTENT QA — unapproved external research; not BODICH products."}\n          <a href={`${import.meta.env.BASE_URL.replace(/\/+$/, "")}/${locale}/qa/`} class="ml-3 text-bodich-accent-hover underline">{locale === "ro" ? "Catalog QA" : "Browse 132 draft references"}</a>\n        </aside>\n      )}\n      <main id="main-content" class="flex-1">
        <slot />
      </main>
      <SiteFooter locale={locale} page={page} />
    </div>
  </body>
</html>
