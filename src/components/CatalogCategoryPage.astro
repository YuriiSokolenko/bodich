---
import { productsInCategory, type CatalogCategoryEntry } from '../catalog';
import { hrefFor, translations, type Locale } from '../i18n';
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteContainer from './ui/SiteContainer.astro';
import SurfaceCard from './ui/SurfaceCard.astro';
import ProductCard from './catalog/ProductCard.astro';

interface Props {
  locale: Locale;
  category: CatalogCategoryEntry;
}

const { locale, category } = Astro.props;
const t = translations[locale];
const copy = category.copy[locale];
const confirmed = productsInCategory(category);
const section = category.section;
---

<SiteLayout locale={locale} page={section} subpath={category.id} title={copy.title} description={copy.description}>
  <SiteContainer>
    <section data-catalog-category={category.id} class="py-16 sm:py-24">
      <nav aria-label={t.catalogBreadcrumbLabel} class="mb-9 text-sm text-bodich-muted">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a class="hover:text-bodich-accent-hover" href={hrefFor(locale, 'home')}>{t.pages.home.label}</a></li>
          <li class="before:mr-2 before:text-bodich-dim before:content-['/']"><a class="hover:text-bodich-accent-hover" href={hrefFor(locale, section)}>{t.pages[section].label}</a></li>
          <li class="before:mr-2 before:text-bodich-dim before:content-['/']">
            <span aria-current="page" class="font-semibold text-bodich-ink">{copy.title}</span>
          </li>
        </ol>
      </nav>
      <p class="mb-5 text-xs font-semibold uppercase tracking-[.18em] text-bodich-accent">{t.previewLabel}</p>
      <h1 class="max-w-4xl font-display text-4xl font-black text-bodich-ink sm:text-6xl">{copy.title}</h1>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-bodich-muted">{copy.description}</p>
      {confirmed.length === 0 ? (
        <div data-catalog-empty-state class="mt-10 max-w-3xl">
          <SurfaceCard>
            <div>
              <h2 class="text-lg font-bold text-bodich-ink">{t.catalogLandingEmptyTitle}</h2>
              <p class="mt-3 text-base leading-7 text-bodich-muted">{t.catalogEmptyCategory}</p>
            </div>
          </SurfaceCard>
        </div>
      ) : (
        <section data-confirmed-products class="mt-10" aria-labelledby="catalog-confirmed-models-heading">
          <h2 id="catalog-confirmed-models-heading" class="text-2xl font-bold text-bodich-ink">
            {t.catalogVerifiedModelsTitle}
          </h2>
          <ul class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {confirmed.map((product) => (
              <li class="min-w-0"><ProductCard locale={locale} product={product} /></li>
            ))}
          </ul>
        </section>
      )}
      <p class="mt-6 max-w-3xl text-sm leading-relaxed text-bodich-muted">{t.catalogPlanningNotice}</p>
    </section>
  </SiteContainer>
</SiteLayout>
