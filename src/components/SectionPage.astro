---
import SiteLayout from '../layouts/SiteLayout.astro';
import { hrefFor, translations, type Locale, type PageKey } from '../i18n';

interface Props {
  locale: Locale;
  page: PageKey;
}

const { locale, page } = Astro.props;
const t = translations[locale];
---

<SiteLayout locale={locale} page={page}>
  <section class="relative isolate overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute right-[-9rem] top-[-12rem] -z-10 h-[30rem] w-[30rem] rounded-full bg-bodich-accent/10 blur-3xl"></div>
    <div class="mx-auto max-w-6xl px-site-gutter pb-site-section pt-20 sm:px-site-gutter-lg sm:pt-28">
      <p class="mb-6 inline-flex rounded-pill border border-bodich-accent/30 bg-bodich-accent/10 px-4 py-2 text-xs font-semibold uppercase tracking-[.18em] text-bodich-accent">
        {t.previewLabel}
      </p>
      <h1 class="max-w-4xl font-display text-4xl font-black leading-tight tracking-tight text-bodich-ink sm:text-6xl">
        {t.pages[page].title}
      </h1>
      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-bodich-muted">
        {page === 'home' ? t.intro : t.placeholder}
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        {page === 'home' ? (
          <a href={hrefFor(locale, 'products')} class="rounded-control bg-bodich-accent px-6 py-3 font-semibold text-bodich-accent-ink transition-colors hover:bg-bodich-accent-hover">
            {t.browseProducts} →
          </a>
        ) : (
          <a href={hrefFor(locale, 'home')} class="rounded-control border border-bodich-control-border px-6 py-3 font-semibold text-bodich-ink transition-colors hover:border-bodich-accent hover:text-bodich-accent">
            ← {t.backHome}
          </a>
        )}
      </div>
    </div>
  </section>
</SiteLayout>
