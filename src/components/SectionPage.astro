---
import SiteLayout from '../layouts/SiteLayout.astro';
import CatalogCategoryNavigation from './CatalogCategoryNavigation.astro';
import ActionLink from './ui/ActionLink.astro';
import ConceptImage from './ui/ConceptImage.astro';
import SiteContainer from './ui/SiteContainer.astro';
import SurfaceCard from './ui/SurfaceCard.astro';
import TurbineConceptPreview from './TurbineConceptPreview.astro';
import { hrefFor, translations, type Locale, type PageKey } from '../i18n';

interface Props {
  locale: Locale;
  page: PageKey;
}

const { locale, page } = Astro.props;
const t = translations[locale];
---

<SiteLayout locale={locale} page={page}>
  <section class="relative isolate overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute right-[-9rem] top-[-12rem] -z-10 h-[30rem] w-[30rem] rounded-full bg-bodich-accent/10 blur-3xl"></div>
    <SiteContainer>
      <div class:list={['pb-site-section', page === 'home' ? 'pt-14 sm:pt-20' : 'pt-20 sm:pt-28']}>
        <p class="mb-6 inline-flex rounded-pill border border-bodich-accent/30 bg-bodich-accent/10 px-4 py-2 text-xs font-semibold uppercase tracking-[.18em] text-bodich-accent">
          {t.previewLabel}
        </p>
        {page === 'home' ? (
          <div data-hero class="relative">
            <div
              aria-hidden="true"
              data-hero-shade
              class="pointer-events-none absolute left-0 top-0 z-[1] hidden aspect-[1672/941] w-full bg-gradient-to-r from-bodich-canvas/95 via-bodich-canvas/30 to-transparent lg:block"
            ></div>
            <div
              data-hero-copy
              class="relative z-10 lg:absolute lg:inset-y-0 lg:left-0 lg:flex lg:w-[32%] lg:flex-col lg:justify-center lg:py-3"
            >
              <h1 class="font-display text-4xl font-black leading-tight tracking-tight text-bodich-ink sm:text-5xl lg:text-4xl xl:text-5xl">
                {t.pages.home.title}
              </h1>
              <p class="mt-6 text-lg leading-relaxed text-bodich-muted lg:mt-4 lg:text-base xl:text-lg">
                {t.intro}
              </p>
              <div class="mt-8 lg:mt-5 xl:mt-8">
                <ActionLink href={hrefFor(locale, 'products')} variant="primary">
                  {t.browseProducts}
                  <span aria-hidden="true">→</span>
                </ActionLink>
              </div>
            </div>
      <!-- Image width hints track SiteContainer (max-w-6xl and mobile/desktop gutters); update these when the layout changes. -->
            <ConceptImage
              src="/images/turbines/bodich-hero-concept.webp"
              srcset="/images/turbines/bodich-hero-concept-640.webp 640w, /images/turbines/bodich-hero-concept-960.webp 960w, /images/turbines/bodich-hero-concept.webp 1672w"
              sizes="(max-width: 640px) calc(100vw - 2.5rem), (max-width: 1023px) calc(100vw - 4rem), 1088px"
              alt={t.heroImageAlt}
              caption={t.conceptRenderingLabel}
              width={1672}
              height={941}
              priority
              class="mt-10 lg:mt-0"
            />
          </div>
        ) : (
          <>
            <h1 class="max-w-4xl font-display text-4xl font-black leading-tight tracking-tight text-bodich-ink sm:text-6xl">
              {t.pages[page].title}
            </h1>
            {(page === 'products' || page === 'accessories') ? (
              <>
                <CatalogCategoryNavigation locale={locale} section={page} />
                {page === 'products' && <TurbineConceptPreview locale={locale} />}
              </>
            ) : (
              <div class="mt-7 max-w-2xl">
                <SurfaceCard>
                  <p class="text-lg leading-relaxed text-bodich-muted">
                    {t.placeholder}
                  </p>
                </SurfaceCard>
              </div>
            )}
            <div class="mt-10 flex flex-wrap gap-4">
              <ActionLink href={hrefFor(locale, 'home')} variant="secondary">
                <span aria-hidden="true">←</span>
                {t.backHome}
              </ActionLink>
            </div>
          </>
        )}
      </div>
    </SiteContainer>
  </section>
</SiteLayout>
