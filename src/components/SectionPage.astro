---
import SiteLayout from '../layouts/SiteLayout.astro';
import { hrefFor, translations, type Locale, type PageKey } from '../i18n';

interface Props {
  locale: Locale;
  page: PageKey;
}

const { locale, page } = Astro.props;
const t = translations[locale];
---

<SiteLayout locale={locale} page={page}>
  <section class="relative isolate overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute right-[-9rem] top-[-12rem] -z-10 h-[30rem] w-[30rem] rounded-full bg-amber-500/10 blur-3xl"></div>
    <div class="mx-auto max-w-6xl px-5 pb-28 pt-20 sm:px-8 sm:pt-28">
      <p class="mb-6 inline-flex rounded-full border border-amber-400/30 bg-amber-400/10 px-4 py-2 text-xs font-semibold uppercase tracking-[.18em] text-amber-300">
        {t.previewLabel}
      </p>
      <h1 class="max-w-4xl text-4xl font-black leading-tight tracking-tight text-white sm:text-6xl">
        {t.pages[page].title}
      </h1>
      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-slate-300">
        {page === 'home' ? t.intro : t.placeholder}
      </p>
      <div class="mt-10 flex flex-wrap gap-4">
        {page === 'home' ? (
          <a href={hrefFor(locale, 'products')} class="rounded bg-amber-400 px-6 py-3 font-semibold text-slate-950 transition-colors hover:bg-amber-300">
            {t.browseProducts} →
          </a>
        ) : (
          <a href={hrefFor(locale, 'home')} class="rounded border border-white/20 px-6 py-3 font-semibold text-white transition-colors hover:border-amber-400 hover:text-amber-300">
            ← {t.backHome}
          </a>
        )}
      </div>
    </div>
  </section>
</SiteLayout>
