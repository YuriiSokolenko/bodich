---
import { hrefFor, translations, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<footer class="border-t border-bodich-border/70 bg-bodich-panel/60 py-8">
  <div class="mx-auto flex max-w-6xl flex-col justify-between gap-4 px-site-gutter text-sm text-bodich-dim sm:flex-row sm:px-site-gutter-lg">
    <p>© {new Date().getFullYear()} BODICH</p>
    <p>{translations[locale].footerNote}</p>
    <a href={hrefFor(locale, 'contact')} class="text-bodich-muted underline hover:text-bodich-ink">{translations[locale].pages.contact.label}</a>
  </div>
</footer>
