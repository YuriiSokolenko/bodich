---
import {
  productHref,
  productImageHref,
  type CatalogCategoryEntry,
  type ConfirmedCatalogProduct,
} from '../../catalog';
import { hrefFor, translations, type Locale } from '../../i18n';
import SiteLayout from '../../layouts/SiteLayout.astro';
import SiteContainer from '../ui/SiteContainer.astro';
import ActionLink from '../ui/ActionLink.astro';

interface Props {
  locale: Locale;
  category: CatalogCategoryEntry;
  product: ConfirmedCatalogProduct;
}

const { locale, category, product } = Astro.props;
if (product.categoryId !== category.id) {
  throw new Error(`Product ${product.id} does not belong to category ${category.id}`);
}
const t = translations[locale];
const copy = product.copy[locale];
const productPath = `${category.id}/${product.slug}`;
---

<SiteLayout locale={locale} page={category.section} subpath={productPath} title={copy.name} description={copy.summary}>
  <SiteContainer>
    <article data-product-detail={product.slug} class="py-16 sm:py-24">
      <nav aria-label={t.catalogBreadcrumbLabel} class="mb-10 text-sm text-bodich-muted">
        <ol class="flex flex-wrap items-center gap-2">
          <li>
            <a class="hover:text-bodich-accent-hover" href={hrefFor(locale, category.section)}>{t.pages[category.section].label}</a>
          </li>
          <li class="before:mr-2 before:text-bodich-dim before:content-['/']">
            <a class="hover:text-bodich-accent-hover" href={hrefFor(locale, category.section, category.id)}>{category.copy[locale].title}</a>
          </li>
          <li class="before:mr-2 before:text-bodich-dim before:content-['/']">
            <span aria-current="page" class="font-semibold text-bodich-ink">{copy.name}</span>
          </li>
        </ol>
      </nav>
      <div class="grid items-start gap-8 lg:grid-cols-2 lg:gap-12">
        {product.image ? (
          <figure class="overflow-hidden rounded-control border border-bodich-border bg-bodich-panel/80 p-4 sm:p-6">
            <img
              src={productImageHref(product.image.src)}
              alt={product.image.alt[locale]}
              width={product.image.width}
              height={product.image.height}
              decoding="async"
              class="h-auto w-full object-contain"
            />
          </figure>
        ) : (
          <div data-product-no-image class="flex min-h-64 items-center justify-center rounded-control border border-bodich-border bg-bodich-panel/80 p-8">
            <p class="max-w-xs text-center text-base text-bodich-muted">{t.catalogImageUnavailable}</p>
          </div>
        )}
        <div>
          <p class="text-xs font-semibold uppercase tracking-[.18em] text-bodich-accent">{category.copy[locale].title}</p>
          <h1 class="mt-5 font-display text-4xl font-black leading-tight text-bodich-ink sm:text-5xl">{copy.name}</h1>
          <section class="mt-8" aria-labelledby="product-description-title">
            <h2 id="product-description-title" class="text-xl font-bold text-bodich-ink">{t.catalogProductDescriptionTitle}</h2>
            <p class="mt-3 text-base leading-7 text-bodich-muted">{copy.summary}</p>
          </section>
          <p class="mt-8 rounded-control border border-bodich-border bg-bodich-panel/70 p-4 text-sm leading-6 text-bodich-muted">
            {t.catalogUnconfirmedDetailsNotice}
          </p>
          <div class="mt-8">
            <ActionLink href={hrefFor(locale, category.section, category.id)} variant="secondary">
              <span aria-hidden="true">←</span> {t.catalogBackToCategory}
            </ActionLink>
          </div>
        </div>
      </div>
    </article>
  </SiteContainer>
</SiteLayout>
