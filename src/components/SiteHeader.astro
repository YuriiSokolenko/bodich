---
import {
  hrefFor,
  otherLocale,
  pageKeys,
  translations,
  type Locale,
  type PageKey,
} from '../i18n';

interface Props {
  locale: Locale;
  page: PageKey;
}

const { locale, page } = Astro.props;
const t = translations[locale];
const alternate = otherLocale(locale);
---

<header class="border-b border-white/10 bg-[#080d15]/95">
  <div class="mx-auto flex min-h-20 max-w-6xl flex-wrap items-center justify-between gap-4 px-5 py-4 sm:px-8">
    <a href={hrefFor(locale, 'home')} class="text-2xl font-black tracking-[.2em] text-white" aria-label="BODICH — home">BODICH</a>

    <nav aria-label={t.navigationLabel} class="hidden items-center gap-5 md:flex">
      {pageKeys.map((key) => (
        <a
          href={hrefFor(locale, key)}
          aria-current={page === key ? 'page' : undefined}
          class:list={[
            'text-sm transition-colors hover:text-amber-400',
            page === key ? 'font-semibold text-amber-400' : 'text-slate-300',
          ]}
        >
          {t.pages[key].label}
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-2 border-l border-white/15 pl-4 md:flex" aria-label={t.languageLabel}>
      <a href={hrefFor(locale, page)} aria-current="page" class="text-sm font-bold text-amber-400">{locale.toUpperCase()}</a>
      <span aria-hidden="true" class="text-slate-600">/</span>
      <a href={hrefFor(alternate, page)} hreflang={alternate} lang={alternate} class="text-sm text-slate-300 hover:text-white">{alternate.toUpperCase()}</a>
    </div>

    <details class="w-full md:hidden">
      <summary class="w-fit cursor-pointer rounded border border-white/25 px-4 py-2 text-sm font-semibold text-white">
        {t.menuLabel}
      </summary>
      <nav aria-label={t.navigationLabel} class="mt-4 flex flex-col gap-1 border-t border-white/10 pt-3">
        {pageKeys.map((key) => (
          <a
            href={hrefFor(locale, key)}
            aria-current={page === key ? 'page' : undefined}
            class:list={[
              'rounded px-3 py-2 text-sm hover:bg-white/10',
              page === key ? 'font-semibold text-amber-400' : 'text-slate-200',
            ]}
          >
            {t.pages[key].label}
          </a>
        ))}
      </nav>
      <div class="mt-3 flex gap-4 border-t border-white/10 px-3 py-3 text-sm" aria-label={t.languageLabel}>
        <span class="font-bold text-amber-400">{locale.toUpperCase()}</span>
        <a href={hrefFor(alternate, page)} hreflang={alternate} lang={alternate} class="text-slate-200 underline">{alternate.toUpperCase()}</a>
      </div>
    </details>
  </div>
</header>
