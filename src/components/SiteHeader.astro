---
import LanguageSwitcher from './LanguageSwitcher.astro';
import {
  hrefFor,
  pageKeys,
  translations,
  type Locale,
  type PageKey,
} from '../i18n';

interface Props {
  locale: Locale;
  page: PageKey;
  subpath?: string;
}

const { locale, page, subpath } = Astro.props;
const t = translations[locale];
---

<header class="sticky top-0 z-50 border-b border-bodich-border/80 bg-bodich-canvas/95 shadow-lg shadow-black/15 backdrop-blur-xl">
  <div class="mx-auto max-w-6xl px-site-gutter sm:px-site-gutter-lg">
    <div class="flex min-h-20 items-center gap-2 sm:gap-4">
      <a
        href={hrefFor(locale, 'home')}
        class="group inline-flex shrink-0 items-center gap-2 sm:gap-3"
      >
        <span aria-hidden="true" class="hidden flex-col gap-1.5 sm:flex">
          <span class="h-1 w-7 -skew-x-12 bg-bodich-accent"></span>
          <span class="h-1 w-5 -skew-x-12 bg-bodich-accent"></span>
        </span>
        <span class="flex flex-col">
          <span class="font-display text-xl font-black italic leading-none tracking-[.08em] text-bodich-ink transition-colors group-hover:text-bodich-accent-hover sm:text-[1.65rem]">
            BODICH
          </span>
          <span class="mt-1 hidden whitespace-nowrap text-[.6875rem] font-semibold uppercase tracking-[.19em] text-bodich-dim sm:block">
            {t.brandDescriptor}
          </span>
        </span>
      </a>

      <nav data-primary-navigation aria-label={t.navigationLabel} class="ml-auto hidden items-center gap-0.5 lg:flex xl:gap-1">
        {pageKeys.map((key) => (
          <a
            href={hrefFor(locale, key)}
            aria-current={key === page ? 'page' : undefined}
            class:list={[
              'whitespace-nowrap rounded-control px-2.5 py-3 text-sm font-semibold transition-colors xl:px-3',
              key === page
                ? 'bg-bodich-panel-raised text-bodich-accent'
                : 'text-bodich-muted hover:bg-bodich-panel hover:text-bodich-ink',
            ]}
          >
            {t.pages[key].label}
          </a>
        ))}
      </nav>

      <div class="ml-auto hidden items-center lg:flex lg:ml-2">
        <LanguageSwitcher locale={locale} page={page} subpath={subpath} />
      </div>

      <div class="ml-auto flex items-center gap-2 lg:hidden">
        <LanguageSwitcher locale={locale} page={page} subpath={subpath} />

        <details data-mobile-navigation class="group relative">
          <summary
            aria-label={t.menuLabel}
            class="flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center gap-2 rounded-control border border-bodich-control-border bg-bodich-panel px-2 text-sm font-semibold text-bodich-ink transition-colors hover:bg-bodich-panel-raised sm:px-3 [&::-webkit-details-marker]:hidden"
          >
            <span class="hidden sm:inline">{t.menuLabel}</span>
            <svg
              aria-hidden="true"
              class="h-5 w-5 group-open:hidden"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            >
              <path d="M4 7h16M4 12h16M4 17h16" />
            </svg>
            <svg
              aria-hidden="true"
              class="hidden h-5 w-5 group-open:block"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            >
              <path d="M5 5l14 14M19 5L5 19" />
            </svg>
          </summary>

          <nav
            aria-label={t.navigationLabel}
            class="absolute right-0 top-[calc(100%+0.75rem)] w-[min(22rem,calc(100vw-2.5rem))] rounded-control border border-bodich-control-border bg-bodich-panel p-2 shadow-2xl shadow-black/50"
          >
            <ul class="flex flex-col gap-1">
              {pageKeys.map((key) => (
                <li>
                  <a
                    href={hrefFor(locale, key)}
                    aria-current={key === page ? 'page' : undefined}
                    class:list={[
                      'flex min-h-11 items-center rounded-control border-l-[3px] px-4 py-2.5 text-sm font-semibold transition-colors',
                      key === page
                        ? 'border-bodich-accent bg-bodich-accent/10 text-bodich-accent'
                        : 'border-transparent text-bodich-muted hover:bg-bodich-panel-raised hover:text-bodich-ink',
                    ]}
                  >
                    {t.pages[key].label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </details>
      </div>
    </div>
  </div>
</header>

<!-- Native <details> still works without JavaScript; this progressive enhancement
     handles two expected dismissal interactions for keyboard and pointer users. -->
<script>
  for (const menu of document.querySelectorAll<HTMLDetailsElement>('[data-mobile-navigation]')) {
    const summary = menu.querySelector('summary');

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        summary?.focus();
      }
    });

    document.addEventListener('pointerdown', (event) => {
      if (menu.open && event.target instanceof Node && !menu.contains(event.target)) {
        menu.open = false;
      }
    });
  }
</script>
