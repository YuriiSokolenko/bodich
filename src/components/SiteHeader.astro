---
import {
  hrefFor,
  otherLocale,
  pageKeys,
  translations,
  type Locale,
  type PageKey,
} from '../i18n';

interface Props {
  locale: Locale;
  page: PageKey;
}

const { locale, page } = Astro.props;
const t = translations[locale];
const alternate = otherLocale(locale);
---

<header class="border-b border-bodich-border/70 bg-bodich-canvas/95">
  <div class="mx-auto flex min-h-20 max-w-6xl flex-wrap items-center justify-between gap-4 px-site-gutter py-4 sm:px-site-gutter-lg">
    <a href={hrefFor(locale, 'home')} class="font-display text-2xl font-black tracking-[.2em] text-bodich-ink" aria-label="BODICH — home">BODICH</a>

    <nav aria-label={t.navigationLabel} class="hidden items-center gap-5 md:flex">
      {pageKeys.map((key) => (
        <a
          href={hrefFor(locale, key)}
          aria-current={page === key ? 'page' : undefined}
          class:list={[
            'text-sm transition-colors hover:text-bodich-accent-hover',
            page === key ? 'font-semibold text-bodich-accent' : 'text-bodich-muted',
          ]}
        >
          {t.pages[key].label}
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-2 border-l border-bodich-border pl-4 md:flex" aria-label={t.languageLabel}>
      <a href={hrefFor(locale, page)} aria-current="page" class="text-sm font-bold text-bodich-accent">{locale.toUpperCase()}</a>
      <span aria-hidden="true" class="text-bodich-dim">/</span>
      <a href={hrefFor(alternate, page)} hreflang={alternate} lang={alternate} class="text-sm text-bodich-muted hover:text-bodich-ink">{alternate.toUpperCase()}</a>
    </div>

    <details class="w-full md:hidden">
      <summary class="w-fit cursor-pointer rounded-control border border-bodich-control-border px-4 py-2 text-sm font-semibold text-bodich-ink">
        {t.menuLabel}
      </summary>
      <nav aria-label={t.navigationLabel} class="mt-4 flex flex-col gap-1 border-t border-bodich-border/70 pt-3">
        {pageKeys.map((key) => (
          <a
            href={hrefFor(locale, key)}
            aria-current={page === key ? 'page' : undefined}
            class:list={[
              'rounded-control px-3 py-2 text-sm hover:bg-bodich-panel-raised',
              page === key ? 'font-semibold text-bodich-accent' : 'text-bodich-muted',
            ]}
          >
            {t.pages[key].label}
          </a>
        ))}
      </nav>
      <div class="mt-3 flex gap-4 border-t border-bodich-border/70 px-3 py-3 text-sm" aria-label={t.languageLabel}>
        <span class="font-bold text-bodich-accent">{locale.toUpperCase()}</span>
        <a href={hrefFor(alternate, page)} hreflang={alternate} lang={alternate} class="text-bodich-muted underline">{alternate.toUpperCase()}</a>
      </div>
    </details>
  </div>
</header>
