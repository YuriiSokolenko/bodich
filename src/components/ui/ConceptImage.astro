---
/**
 * Displays a BODICH concept image with a visible localized disclosure.
 *
 * Callers must supply meaningful alt text and a localized caption, e.g.
 * "Concept rendering" (EN) or "Vizualizare conceptuală" (RO).
 * Public assets (currently WebP) are served directly; optional srcset/sizes
 * point to separately generated responsive files. For width-descriptor srcset,
 * sizes defaults to 100vw; this component does not create responsive files.
 */
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  caption: string;
  srcset?: string;
  sizes?: string;
  priority?: boolean;
  class?: string;
  imageClass?: string;
}

const {
  src,
  alt,
  width,
  height,
  caption,
  srcset,
  sizes,
  priority = false,
  class: figureClass,
  imageClass,
} = Astro.props;

// Empty alt would incorrectly mark this meaningful image as decorative;
// an empty caption would silently remove the concept-art disclosure.
if (!alt.trim()) throw new Error('ConceptImage: meaningful `alt` is required');
if (!caption.trim()) throw new Error('ConceptImage: visible concept `caption` is required');

// Assets from public/ need a deployment base prefix (e.g. /bodich-preview).
// srcset is a comma-separated list of local asset paths with width descriptors.
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const assetHref = (path: string) =>
  path.startsWith('/') && !path.startsWith('//') ? `${base}${path}` : path;
const resolvedSrcset = srcset?.split(',').map((item) => {
  const [path, descriptor] = item.trim().split(/\s+/, 2);
  return [assetHref(path), descriptor].filter(Boolean).join(' ');
}).join(', ');
---

<figure class:list={['min-w-0', figureClass]}>
  <img
    src={assetHref(src)}
    srcset={resolvedSrcset}
    sizes={resolvedSrcset ? (sizes ?? '100vw') : undefined}
    alt={alt}
    width={width}
    height={height}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    decoding="async"
    class:list={['block h-auto w-full max-w-full rounded-control object-contain', imageClass]}
  />
  <figcaption class="mt-2 text-sm font-medium text-bodich-muted">{caption}</figcaption>
</figure>
