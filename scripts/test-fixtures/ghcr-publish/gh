#!/usr/bin/env bash
# Test stub for `gh api <endpoint> --jq <expr>` used by scripts/ghcr-publish.test.mjs.
# It prints the current branch head from $STUB_DIR/head and logs the call, so the
# tests can assert which endpoint was read and in what order relative to docker calls.
set -eu
echo "gh $*" >> "$STUB_DIR/calls.log"
if [ "${1:-}" != api ]; then
  echo "unexpected gh invocation: $*" >&2
  exit 99
fi
cat "$STUB_DIR/head"
