{
  "name": "bodich-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check && npm run media:check && npm run media:self-test && node scripts/validate-catalog.mjs && node scripts/validate-catalog.mjs --self-test && npm run catalog:review:ledger:check && npm run catalog:review:ledger:self-test && npm run catalog:genuine:check && npm run catalog:genuine:self-test && npm run catalog:products:check && npm run catalog:products:self-test && npm run catalog:source:check && npm run catalog:reconcile && npm run seo:check && npm run seo:self-test",
    "build": "astro build",
    "build:beta": "BODICH_MEDIA_PROFILE=beta_presentation npm run media:stage-beta && BODICH_MEDIA_PROFILE=beta_presentation npm run build && BODICH_MEDIA_PROFILE=beta_presentation npm run media:beta",
    "preview": "astro preview",
    "catalog:intake": "node scripts/validate-catalog.mjs --intake",
    "catalog:source:check": "node scripts/audit-kingtech-source.mjs --self-test && node scripts/validate-source-inventory.mjs && node scripts/validate-source-inventory.mjs --self-test && node scripts/validate-accessories.mjs && node scripts/validate-accessories.mjs --self-test && node scripts/validate-consumables.mjs && node scripts/validate-consumables.mjs --self-test && node scripts/validate-commerce-references.mjs && node scripts/validate-commerce-references.mjs --self-test && npm run catalog:art:manifest && npm run catalog:art:self-test && npm run catalog:copy:check && npm run catalog:copy:self-test",
    "catalog:reconcile": "node scripts/reconcile-catalog-release.mjs --check && node scripts/reconcile-catalog-release.mjs --self-test",
    "catalog:reconcile:routes": "node scripts/reconcile-catalog-release.mjs --routes dist",
    "catalog:source:refresh": "node scripts/audit-kingtech-source.mjs --write --browser",
    "catalog:art:manifest": "node scripts/generate-catalog-art.mjs",
    "catalog:art:generate": "node scripts/generate-catalog-art.mjs --generate",
    "catalog:art:check": "node scripts/generate-catalog-art.mjs --check",
    "catalog:art:self-test": "node scripts/generate-catalog-art.mjs --self-test",
    "catalog:copy:check": "node scripts/validate-catalog-copy.mjs",
    "catalog:copy:self-test": "node scripts/validate-catalog-copy.mjs --self-test",
    "catalog:copy:matrix": "node scripts/validate-catalog-copy.mjs --write-matrix",
    "catalog:review:build": "node scripts/build-catalog-review.mjs",
    "catalog:review:check": "node scripts/build-catalog-review.mjs --check",
    "catalog:review:self-test": "node scripts/build-catalog-review.mjs --self-test",
    "catalog:review:ledger:check": "node scripts/catalog-review-ledger.mjs --check",
    "catalog:review:ledger:self-test": "node scripts/catalog-review-ledger.mjs --self-test",
    "catalog:review:ledger:export": "node scripts/catalog-review-ledger.mjs --export",
    "catalog:review:ledger:plan": "node scripts/catalog-review-ledger.mjs --migrate-plan",
    "catalog:genuine:check": "node scripts/catalog-genuine-evidence.mjs --check",
    "catalog:genuine:self-test": "node scripts/catalog-genuine-evidence.mjs --self-test",
    "catalog:genuine:export": "node scripts/catalog-genuine-evidence.mjs --export",
    "media:check": "node scripts/catalog-media-policy.mjs --check",
    "media:self-test": "node scripts/catalog-media-policy.mjs --self-test",
    "media:generated": "node scripts/catalog-media-policy.mjs --require-generated",
    "media:inventory": "node scripts/catalog-media-policy.mjs --inventory",
    "media:public": "node scripts/catalog-media-policy.mjs --public dist",
    "media:stage-private": "node scripts/catalog-media-policy.mjs --stage-private",
    "media:stage-beta": "node scripts/catalog-media-policy.mjs --stage-beta",
    "media:beta": "node scripts/catalog-media-policy.mjs --beta dist",
    "seo:self-test": "node scripts/validate-editorial-seo.mjs --self-test",
    "seo:check": "node scripts/validate-editorial-seo.mjs",
    "seo:routes": "node scripts/validate-editorial-seo.mjs --routes dist",
    "seo:fixture": "node scripts/verify-editorial-approval-fixture.mjs",
    "catalog:products:check": "node scripts/catalog-product-registry.mjs --check",
    "catalog:products:self-test": "node scripts/catalog-product-registry.mjs --self-test",
    "catalog:products:export": "node scripts/catalog-product-registry.mjs --export",
    "catalog:products:dist": "node scripts/catalog-product-registry.mjs --dist-check dist",
    "pages:verify": "node scripts/verify-pages-release.mjs dist",
    "pages:self-test": "node scripts/verify-pages-release.mjs --self-test"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.2",
    "parse5": "8.0.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
